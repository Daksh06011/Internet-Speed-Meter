                            <item android:offset="0.14" android:color="#FF0E43E1" />
                            <item android:offset="0.36" android:color="#FF0E6A86" />
                            <item android:offset="0.55" android:color="#FF0F95AE" />
                            <item android:offset="0.75" android:color="#FF29CEE1" />
                            <item android:offset="0.86" android:color="#FF2BD9EC" />
                            <item android:offset="0.905" android:color="#FF1476F2" />
                            <item android:offset="1.00" android:color="#FF127FF4" />
