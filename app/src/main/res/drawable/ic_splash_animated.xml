                android:pivotX="54"
                android:pivotY="54"
                android:rotation="-35"
                android:scaleX="0.85"
                android:scaleY="0.85">
                <path
                    android:name="ticks"
                    android:pathData="M43.59,66.41 L41.66,68.71 M40.82,65.06 L39.29,66.34 M39.10,62.60 L37.37,63.60 M37.84,59.88 L35.96,60.57 M38.05,56.81 L35.09,57.33 M36.80,54.00 L34.80,54.00 M37.06,51.01 L35.09,50.67 M37.84,48.12 L35.96,47.43 M39.97,45.90 L37.37,44.40 M40.82,42.94 L39.29,41.66 M42.94,40.82 L41.66,39.29 M45.40,39.10 L44.40,37.37 M48.46,38.78 L47.43,35.96 M51.01,37.06 L50.67,35.09 M54.00,36.80 L54.00,34.80 M56.99,37.06 L57.33,35.09 M59.54,38.78 L60.57,35.96 M62.60,39.10 L63.60,37.37 M65.06,40.82 L66.34,39.29 M67.18,42.94 L68.71,41.66 M68.03,45.90 L70.63,44.40 M70.16,48.12 L72.04,47.43 M70.94,51.01 L72.91,50.67 M71.20,54.00 L73.20,54.00 M69.95,56.81 L72.91,57.33 M70.16,59.88 L72.04,60.57 M68.90,62.60 L70.63,63.60 M67.18,65.06 L68.71,66.34 M64.41,66.41 L66.34,68.71"
                    android:strokeWidth="0.7"
                    android:strokeColor="#FF9AA6B6"
                    android:strokeLineCap="round"
                    android:strokeAlpha="0" />
                <path
                    android:name="glowOuter"
                    android:pathData="M38.57,72.39 A24,24 0 1,1 69.43,72.39"
                    android:strokeWidth="15"
                    android:strokeAlpha="0.07"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0">
                    <aapt:attr name="android:strokeColor">
                        <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                            <item android:offset="0.00" android:color="#FF127FF4" />
                            <item android:offset="0.14" android:color="#FF0E43E1" />
                            <item android:offset="0.36" android:color="#FF0E6A86" />
                            <item android:offset="0.55" android:color="#FF0F95AE" />
                            <item android:offset="0.75" android:color="#FF29CEE1" />
                            <item android:offset="0.86" android:color="#FF2BD9EC" />
                            <item android:offset="0.905" android:color="#FF1476F2" />
                            <item android:offset="1.00" android:color="#FF127FF4" />
                        </gradient>
                    </aapt:attr>
                </path>
                <path
                    android:name="glow"
                    android:pathData="M38.57,72.39 A24,24 0 1,1 69.43,72.39"
                    android:strokeWidth="10"
                    android:strokeAlpha="0.22"
                    android:strokeLineCap="round"
                    android:trimPathEnd="0">
                    <aapt:attr name="android:strokeColor">
                        <gradient android:type="sweep" android:centerX="54" android:centerY="54">
                            <item android:offset="0.00" android:color="#FF127FF4" />
                            <item android:offset="0.14" android:color="#FF0E43E1" />
                            <item android:offset="0.36" android:color="#FF0E6A86" />
                            <item android:offset="0.55" android:color="#FF0F95AE" />
                            <item android:offset="0.75" android:color="#FF29CEE1" />
                            <item android:offset="0.86" android:color="#FF2BD9EC" />
                            <item android:offset="0.905" android:color="#FF1476F2" />
                            <item android:offset="1.00" android:color="#FF127FF4" />
