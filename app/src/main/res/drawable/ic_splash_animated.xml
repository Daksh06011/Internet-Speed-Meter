                        android:strokeWidth="0.6"
                        android:strokeColor="#FF2B313A">
                        <aapt:attr name="android:fillColor">
                            <gradient android:type="radial" android:centerX="52.6" android:centerY="52.4" android:gradientRadius="6">
                                <item android:offset="0" android:color="#FFFFFFFF" />
                                <item android:offset="0.45" android:color="#FFC7CED7" />
