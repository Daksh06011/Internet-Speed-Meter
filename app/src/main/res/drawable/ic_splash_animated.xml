<?xml version="1.0" encoding="utf-8"?>
<!-- Launch animation (Android 12+): the gauge sweeps up like a speed test, eases back to
     rest, and the centre dot pops in. Pure vector, a few hundred bytes. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:pathData="M39.86,72.85 A22,22 0 1,1 68.14,72.85"
                android:strokeWidth="6"
                android:strokeColor="@color/icon_track"
                android:strokeLineCap="round" />
            <path
                android:name="progress"
                android:pathData="M39.86,72.85 A22,22 0 1,1 68.14,72.85"
                android:strokeWidth="6"
                android:strokeColor="@color/icon_accent"
                android:strokeLineCap="round"
                android:trimPathEnd="0" />
            <group
                android:name="dot"
                android:pivotX="54"
                android:pivotY="56"
                android:scaleX="0"
                android:scaleY="0">
                <path
                    android:pathData="M54,56 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
                    android:fillColor="@color/icon_accent" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="progress">
        <aapt:attr name="android:animation">
            <set android:ordering="sequentially">
                <objectAnimator
                    android:duration="480"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0"
                    android:valueTo="0.94"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="320"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="trimPathEnd"
                    android:valueFrom="0.94"
                    android:valueTo="0.62"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="120"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="300"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="120"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
